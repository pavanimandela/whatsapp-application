<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>WhatsApp Messenger</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    height: 100vh;
    overflow: hidden;
    background: #d9dbd5;
}

/* ================= APP ================= */

.app {
    height: 100vh;
    max-width: 1500px;
    margin: auto;
    display: flex;
    background: white;
}

/* ================= SIDEBAR ================= */

.sidebar {
    width: 35%;
