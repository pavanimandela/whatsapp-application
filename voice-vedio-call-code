<script>

/* =====================================================
                    GLOBAL VARIABLES
===================================================== */

let callTimerInterval;

let seconds = 0;

let localStream = null;

let microphoneMuted = false;

let cameraEnabled = true;

let speakerEnabled = true;

let currentCallType = "";


/* =====================================================
                    OPEN CHAT
===================================================== */

function openChat(name, icon) {

    document.getElementById("headerName").innerText = name;

    document.getElementById("headerPic").innerText = icon;

    if (window.innerWidth <= 700) {

        document
            .getElementById("sidebar")
            .classList.add("hide");

        document
            .getElementById("chatArea")
            .classList.add("show");
    }
}


/* =====================================================
                    SEND MESSAGE
===================================================== */

function sendMessage() {

    const input =
        document.getElementById("messageInput");

    const text = input.value.trim();

    if (text === "") {
        return;
    }

    const messages =
        document.getElementById("messages");

    const message =
        document.createElement("div");

    message.className = "message sent";

    message.innerHTML =
        text +
        '<span class="time">' +
        getTime() +
        ' <span class="tick">✓✓</span>' +
        '</span>';

    messages.appendChild(message);

    input.value = "";

    messages.scrollTop =
        messages.scrollHeight;

    /* Demo reply */

    setTimeout(function () {

        const reply =
            document.createElement("div");

        reply.className =
            "message received";

        reply.innerHTML =
            "Okay 👍" +
            '<span class="time">' +
            getTime() +
            '</span>';

        messages.appendChild(reply);

        messages.scrollTop =
            messages.scrollHeight;

    }, 1000);
}


/* =====================================================
                    ENTER KEY
===================================================== */

function handleEnter(event) {

    if (event.key === "Enter") {
        sendMessage();
    }
}


/* =====================================================
                    TIME
===================================================== */

function getTime() {

    const date = new Date();

    let hours = date.getHours();

    let minutes = date.getMinutes();

    const ampm =
        hours >= 12 ? "PM" : "AM";

    hours = hours % 12;

    hours = hours || 12;

    minutes =
        minutes < 10
        ? "0" + minutes
        : minutes;

    return hours + ":" + minutes + " " + ampm;
}


/* =====================================================
                    SEARCH
===================================================== */

function searchChats() {

    const value =
        document
        .getElementById("search")
        .value
        .toLowerCase();

    const chats =
        document.querySelectorAll(".chat");

    chats.forEach(function (chat) {

        const name =
            chat.dataset.name.toLowerCase();

        if (name.includes(value)) {

            chat.style.display = "flex";

        } else {

            chat.style.display = "none";
        }

    });
}


/* =====================================================
                    EMOJI
===================================================== */

function toggleEmoji() {

    const box =
        document.getElementById("emojiBox");

    if (box.style.display === "block") {

        box.style.display = "none";

    } else {

        box.style.display = "block";
    }
}


function addEmoji(value) {

    const input =
        document.getElementById("messageInput");

    input.value += value;

    input.focus();

    document
        .getElementById("emojiBox")
        .style.display = "none";
}


/* =====================================================
                  GET CURRENT CONTACT
===================================================== */

function getContactName() {

    return document
        .getElementById("headerName")
        .innerText;
}


function getContactIcon() {

    return document
        .getElementById("headerPic")
        .innerText;
}


/* =====================================================
                    START VOICE CALL
===================================================== */

async function startVoiceCall() {

    currentCallType = "voice";

    const name = getContactName();

    const icon = getContactIcon();

    document
        .getElementById("callScreen")
        .style.display = "flex";

    document
        .getElementById("normalCall")
        .style.display = "block";

    document
        .getElementById("videoContainer")
        .style.display = "none";

    document
        .getElementById("callTitle")
        .innerText = name;

    document
        .getElementById("callName")
        .innerText = name;

    document
        .getElementById("callAvatar")
        .innerText = icon;

    document
        .getElementById("callStatus")
        .innerText = "Calling...";

    document
        .getElementById("cameraButton")
        .style.display = "none";

    await requestMicrophone();

    startTimer();
}


/* =====================================================
                    START VIDEO CALL
===================================================== */

async function startVideoCall() {

    currentCallType = "video";

    const name = getContactName();

    document
        .getElementById("callScreen")
        .style.display = "flex";

    document
        .getElementById("normalCall")
        .style.display = "none";

    document
        .getElementById("videoContainer")
        .style.display = "block";

    document
        .getElementById("callTitle")
        .innerText = name;

    document
        .getElementById("callStatus")
        .innerText = "Starting video call...";

    document
        .getElementById("cameraButton")
        .style.display = "block";

    await requestCamera();

    startTimer();
}


/* =====================================================
              REQUEST MICROPHONE
===================================================== */

async function requestMicrophone() {

    try {

        localStream =
            await navigator.mediaDevices.getUserMedia({
                audio: true
            });

        document
            .getElementById("callStatus")
            .innerText = "Connected";

    } catch (error) {

        document
            .getElementById("callStatus")
            .innerText =
            "Microphone permission denied";
    }
}


/* =====================================================
                  REQUEST CAMERA
===================================================== */

async function requestCamera() {

    try {

        localStream =
            await navigator.mediaDevices.getUserMedia({
                audio: true,
                video: true
            });

        const video =
            document.getElementById("localVideo");

        video.srcObject = localStream;

        document
            .getElementById("callStatus")
            .innerText = "Connected";

    } catch (error) {

        document
            .getElementById("callStatus")
            .innerText =
            "Camera/microphone permission denied";
    }
}


/* =====================================================
                    CALL TIMER
===================================================== */

function startTimer() {

    clearInterval(callTimerInterval);

    seconds = 0;

    updateTimer();

    callTimerInterval =
        setInterval(function () {

            seconds++;

            updateTimer();

        }, 1000);
}


function updateTimer() {

    const minutes =
        Math.floor(seconds / 60);

    const remainingSeconds =
        seconds % 60;

    const formattedMinutes =
        minutes < 10
        ? "0" + minutes
        : minutes;

    const formattedSeconds =
        remainingSeconds < 10
        ? "0" + remainingSeconds
        : remainingSeconds;

    document
        .getElementById("callTimer")
        .innerText =
        formattedMinutes +
        ":" +
        formattedSeconds;
}


/* =====================================================
                    MUTE
===================================================== */

function toggleMute() {

    microphoneMuted =
        !microphoneMuted;

    if (localStream) {

        localStream
            .getAudioTracks()
            .forEach(function (track) {

                track.enabled =
                    !microphoneMuted;

            });
    }

    const button =
        document.getElementById("muteButton");

    button.innerText =
        microphoneMuted
        ? "🔇"
        : "🎤";
}


/* =====================================================
                    CAMERA
===================================================== */

function toggleCamera() {

    cameraEnabled =
        !cameraEnabled;

    if (localStream) {

        localStream
            .getVideoTracks()
            .forEach(function (track) {

                track.enabled =
                    cameraEnabled;

            });
    }

    const button =
        document.getElementById("cameraButton");

    button.innerText =
        cameraEnabled
        ? "📷"
        : "🚫";
}


/* =====================================================
                    SPEAKER
===================================================== */

function toggleSpeaker() {

    speakerEnabled =
        !speakerEnabled;

    const button =
        document.getElementById("speakerButton");

    button.innerText =
        speakerEnabled
        ? "🔊"
        : "🔇";
}


/* =====================================================
                    END CALL
===================================================== */

function endCall() {

    clearInterval(callTimerInterval);

    if (localStream) {

        localStream
            .getTracks()
            .forEach(function (track) {

                track.stop();

            });

        localStream = null;
    }

    document
        .getElementById("callScreen")
        .style.display = "none";

    document
        .getElementById("localVideo")
        .srcObject = null;

    document
        .getElementById("callStatus")
        .innerText = "Calling...";

    seconds = 0;

    microphoneMuted = false;

    cameraEnabled = true;

    document
        .getElementById("muteButton")
        .innerText = "🎤";

    document
        .getElementById("cameraButton")
        .innerText = "📷";
}

