                    type="text"
                    id="messageInput"
                    class="message-input"
                    placeholder="Type a message"
                    onkeypress="handleEnter(event)"
                >

                <button
                    class="send-btn"
                    onclick="sendMessage()">
                    ➤
                </button>

            </div>

