                     data-name="Priya"
                     onclick="openChat('Priya','👩')">

                    <div class="chat-pic">👩</div>

                    <div class="chat-details">

                        <div class="chat-top">
                            <span class="chat-name">Priya</span>
                            <span class="chat-time">3:40 PM</span>
                        </div>

