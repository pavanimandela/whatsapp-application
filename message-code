                    <div class="chat-details">

                        <div class="chat-top">
                            <span class="chat-name">Kiran</span>
                            <span class="chat-time">Yesterday</span>
                        </div>

                        <div class="last-message">
                            Good morning!
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ================= CHAT AREA ================= -->

