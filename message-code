</div>


<script>

/* =========================================================
                         LOGIN
========================================================= */

function login() {

    const phone =
        document.getElementById("phone").value.trim();

    const country =
        document.getElementById("country").value;

    const error =
        document.getElementById("error");

    error.textContent = "";

    if (phone === "") {

        error.textContent =
            "Please enter your phone number.";

        return;
    }

    if (!/^[0-9]+$/.test(phone)) {

        error.textContent =
            "Phone number must contain only numbers.";

        return;
    }

    if (country === "+91" && phone.length !== 10) {

        error.textContent =
            "Please enter a valid 10-digit phone number.";

        return;
    }

    document.getElementById("loginPage").style.display = "none";

    document.getElementById("messengerPage").style.display = "block";
}


/* =========================================================
                         OPEN CHAT
========================================================= */

function openChat(name, emoji) {

    document.getElementById("headerName").textContent = name;

    document.getElementById("headerPic").textContent = emoji;

    document.getElementById("sidebar").classList.add("mobile-hidden");

    document.getElementById("chatArea").classList.add("mobile-show");

    if (window.innerWidth > 700) {

        document.getElementById("sidebar")
            .classList.remove("mobile-hidden");

        document.getElementById("chatArea")
            .classList.remove("mobile-show");
    }
}


/* =========================================================
                         BACK BUTTON
========================================================= */

function backToChats() {

    document.getElementById("sidebar")
        .classList.remove("mobile-hidden");

    document.getElementById("chatArea")
        .classList.remove("mobile-show");
}


/* =========================================================
                         SEND MESSAGE
========================================================= */

function sendMessage() {

    const input =
        document.getElementById("messageInput");

    const text = input.value.trim();

    if (text === "") {
        return;
    }

    const messages =
        document.getElementById("messages");

    const message =
        document.createElement("div");

    message.className = "message sent";

    const now = new Date();

    let hours = now.getHours();

    let minutes = now.getMinutes();

    let ampm = hours >= 12 ? "PM" : "AM";

    hours = hours % 12;

    hours = hours ? hours : 12;

    minutes =
        minutes < 10 ? "0" + minutes : minutes;

    const time =
        hours + ":" + minutes + " " + ampm;

    message.innerHTML =
        text +
        '<span class="message-time">' +
        time +
        ' <span class="tick">✓✓</span>' +
        '</span>';

    messages.appendChild(message);

    input.value = "";

    messages.scrollTop =
        messages.scrollHeight;

    /* Demo automatic reply */

    setTimeout(function() {

        const reply =
            document.createElement("div");

        reply.className = "message received";

        reply.innerHTML =
            "Thanks for your message 😊" +
            '<span class="message-time">' +
            getCurrentTime() +
            '</span>';

        messages.appendChild(reply);

        messages.scrollTop =
            messages.scrollHeight;

    }, 1000);
}


/* =========================================================
                         ENTER KEY
========================================================= */

function handleEnter(event) {

    if (event.key === "Enter") {

        sendMessage();
    }
}


/* =========================================================
                         CURRENT TIME
========================================================= */

function getCurrentTime() {

    const now = new Date();

    let hours = now.getHours();

    let minutes = now.getMinutes();

    let ampm = hours >= 12 ? "PM" : "AM";

    hours = hours % 12;

    hours = hours ? hours : 12;

    minutes =
        minutes < 10 ? "0" + minutes : minutes;

    return hours + ":" + minutes + " " + ampm;
}


/* =========================================================
                         SEARCH CHATS
========================================================= */

function searchChats() {

    const search =
        document.getElementById("search")
            .value
            .toLowerCase();

    const chats =
        document.querySelectorAll(".chat");

    chats.forEach(function(chat) {

        const name =
            chat.getAttribute("data-name")
                .toLowerCase();

        if (name.includes(search)) {

            chat.style.display = "flex";

        } else {

            chat.style.display = "none";
        }

    });
}


/* =========================================================
                         EMOJI
========================================================= */

function toggleEmoji() {

    const picker =
        document.getElementById("emojiPicker");

    if (picker.style.display === "block") {

        picker.style.display = "none";

    } else {

        picker.style.display = "block";
    }
}


function addEmoji(emoji) {

    const input =
        document.getElementById("messageInput");

    input.value += emoji;

    input.focus();

    document.getElementById("emojiPicker")
        .style.display = "none";
}

</script>

</body>
</html>
